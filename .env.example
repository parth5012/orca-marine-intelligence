# ORCA Marine Intelligence Environment Variables

# INCOIS session cookie (daily refresh from TextDataHome)
INCOIS_JSESSIONID=your_session_id_here

# Cron auth shared secret (Vercel Cron + backend POST /api/pfz/refresh + Render Cron Job)
# Generate: openssl rand -hex 32
# Required in every env except explicit local dev (ALLOW_UNAUTHENTICATED_REFRESH=true).
# Never enable ALLOW_UNAUTHENTICATED_REFRESH in production.
CRON_SECRET=change_me_in_prod
ALLOW_UNAUTHENTICATED_REFRESH=false

# Bhashini ULCA API (22-language translation, ASR voice-to-text, TTS)
BHASHINI_API_KEY=your_api_key_here
BHASHINI_ULCA_URL=https://meity-auth.ulcacontrib.org
# ULCA user ID (REQUIRED for voice: POST /api/chat/voice Config call header `userID`)
BHASHINI_ULCA_USER_ID=your_ulca_user_id_here
# Optional ASR overrides (defaults match research #192 contract)
# BHASHINI_PIPELINE_ID=64392f96daac500b55c543cd
# BHASHINI_ASR_TIMEOUT_S=30
# NOTE: voice transcription uses Bhashini ULCA ASR only (backend converts
# browser webm/opus to 16kHz mono WAV via ffmpeg — deploy image needs ffmpeg).
# GROQ_API_KEY below is for the query planner only, never the voice path.

# PostGIS database (Docker: orca:orca@localhost:5432/orca_marine)
DATABASE_URL=postgresql://orca:orca@localhost:5432/orca_marine

# Redis cache (6h PFZ + multi-turn memory + request deduplication)
# Option A - Local Docker: redis://localhost:6379/0
# Option B - Upstash Cloud (256 MB free forever, no credit card): rediss://default:PASSWORD@ENDPOINT.upstash.io:6379
REDIS_URL=redis://localhost:6379/0

# Data Source Mode:
# live: Real Open-Meteo Marine/Weather APIs, real INCOIS data/pfz-today.geojson, and real EEZ/MPA geofences
# mock: Deterministic offline simulation controller for air-gapped unit testing
ORCA_DATA_SOURCE=live

# Simulation Scenario controller (only active when ORCA_DATA_SOURCE=mock):
# normal | rough_seas | cyclone_warning | border_violation
ORCA_SCENARIO=normal

# Open-Meteo Telemetry (No API key required for non-commercial / research use)
# For commercial deployments, configure your paid Open-Meteo API key:
# OPEN_METEO_API_KEY=your_commercial_key_here

# LLM Providers (Fast sub-second synthesis and reasoning)
# Groq API Key (Primary for low-latency dynamic query planner)
GROQ_API_KEY=your_groq_api_key_here
ORCA_PLANNER_MODEL=openai/gpt-oss-120b

# Gemini / Google API Key (Fallback for query planning and synthesis)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# LangSmith Telemetry & Observability (Zero-crash fallback when omitted)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=orca-marine-intelligence
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# CARTO Base Maps API Key (Optional / deprecated; keyless CARTO CDN works when blank).
# Leave empty to use keyless raster CDN URLs (no ?api_key appended).
# Only set if you need authenticated vector/raster tile access.
# CARTO_API_KEY=

# App config
PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://cron-system.vercel.app
# Add your Vercel prod domain + onrender backend origin, comma-separated, e.g.
# ALLOWED_ORIGINS=http://localhost:3000,https://cron-system.vercel.app,https://<your-app>.vercel.app,https://orca-marine-intelligence-api.onrender.com

# Agent Execution Timeouts & Budgets (5-10s range)
ORCA_NODE_TIMEOUT_S=10
# Realistic 12s Gemini synthesis budget (tail latency + single bounded retry on timeout)
ORCA_SYNTHESIZER_TIMEOUT_MS=12000
ORCA_PLANNER_TIMEOUT_MS=5000
ORCA_PER_AGENT_TIMEOUT_S=6

# Inland GPS threshold in km (browser GPS > threshold from coast ignored if query names a coastal port)
ORCA_INLAND_GPS_THRESHOLD=50

# Officer dashboard auth (Map #170 T2, backend/routers/officer.py)
# Shared tokens: PORT_TOKEN = port-officer role (must scope reads with ?port_id=),
# WATCH_TOKEN = enforcement/watch role (read-all). Sent as X-Officer-Token header;
# the Next.js password screen stores officer_role in an httpOnly cookie and the
# proxy forwards it as the header. No user table. Generate: openssl rand -hex 32.
PORT_TOKEN=change_me_port_token
WATCH_TOKEN=change_me_watch_token
OFFICER_COOKIE=officer_role

# Officer Go-No-Go card kill switch (Map #170 T4, frontend/officer/GoNoGoCard.tsx).
# true (default): card fetches /api/weather/current + /cyclone and posts overrides.
# false: #gonogo slot hidden, page boots to register/watch, no weather fetch from card.
# Mirror in frontend/.env.example as NEXT_PUBLIC_ORCA_ENABLE_GONOGO.
ORCA_ENABLE_GONOGO=true
