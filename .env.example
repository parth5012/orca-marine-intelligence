# ORCA Marine Intelligence Environment Variables

# INCOIS session cookie — refresh daily via curl TextDataHome
INCOIS_JSESSIONID=your_session_id_here

# Bhashini ULCA API key for 22-language translation
BHASHINI_API_KEY=your_api_key_here
BHASHINI_ULCA_URL=https://meity-auth.ulcacontrib.org

# PostGIS database (Docker: orca:orca@localhost:5432/orca_marine)
DATABASE_URL=postgresql://orca:orca@localhost:5432/orca_marine

# Redis cache (6h PFZ + multi-turn memory)
REDIS_URL=redis://localhost:6379/0

# IMD weather API (real wind/cyclone W2)
IMD_API_URL=https://mausam.imd.gov.in

# Copernicus Marine (backlog W5 fallback)
COPERNICUS_USER=your_username
COPERNICUS_PASSWORD=your_password

# App config
PORT=8000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://cron-system.vercel.app
