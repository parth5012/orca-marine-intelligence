    {
      "id": "1357ee5e61d34bb088114",
      "type": "text",
      "x": 60,
      "y": 215,
      "width": 371.25000000000006,
      "height": 243.75,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 127978095,
      "version": 1,
      "versionNonce": 402418011,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1758000000000,
      "link": null,
      "locked": false,
      "isLocked": false,
      "text": "Full form: Ocean EcOsystem Reasoning\nwith Collaborative Agents (per PS)\n\nMission: turn raw INCOIS PFZ tables + live\nocean/weather data into ONE safe, cited,\nmultilingual advisory with a map route.\n\nProblem: 437 daily PFZ rows are English\ntext tables \u2014 no safety, no map, no language.\n\nFix: table \u2192 map dots \u2192 4 parallel safety\nchecks \u2192 winner + proof + route in the\nfisherman's own language (22 langs).",
      "fontSize": 15,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Full form: Ocean EcOsystem Reasoning\nwith Collaborative Agents (per PS)\n\nMission: turn raw INCOIS PFZ tables + live\nocean/weather data into ONE safe, cited,\nmultilingual advisory with a map route.\n\nProblem: 437 daily PFZ rows are English\ntext tables \u2014 no safety, no map, no language.\n\nFix: table \u2192 map dots \u2192 4 parallel safety\nchecks \u2192 winner + proof + route in the\nfisherman's own language (22 langs).",
      "lineHeight": 1.25,
      "baseline": 15
    },
