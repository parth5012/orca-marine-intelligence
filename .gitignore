# ORCA Marine Intelligence — .gitignore

# Temp files (audit reports, handoff docs)
.tmp/

# Dependencies
node_modules/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/

# Environment variables (never commit secrets)
.env
.env.local
.env.*.local

# Build output
frontend/.next/
frontend/out/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
docker-compose.override.yml

# Data (large files — keep only .geojson samples)
data/*.csv
data/*.nc
data/*.zip
data/*.parquet
data/marine_data_package/
!data/*.geojson
!data/pfz-today.geojson

# Harness — per-member work logs (gitignored to avoid merge conflicts between M-A/B/C/D/E)
# General harness is tracked: AGENTS.md, docs/notion/*
# Per-member local logs are ignored — each member keeps their own copy per AGENTS.md §2
LOG.md
LOG_*.md
BLOCKED.md
BLOCKED_*.md
LEARNINGS.md
TECH_DEBT.md
docs/wayfinder
Logs
*.log

# Teaching workspace
teach/
reports/


*.pptx
commands.md
generate_techstack_ppt.py

.ruff_cache/
