{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "outputDirectory": ".next",
  "rewrites": [
    {
      "source": "/api/weather/:path*",
      "destination": "https://orca-marine-intelligence-backend.vercel.app/api/weather/:path*"
    },
    {
      "source": "/api/geofence/:path*",
      "destination": "https://orca-marine-intelligence-backend.vercel.app/api/geofence/:path*"
    },
    {
      "source": "/api/officer/:path*",
      "destination": "https://orca-marine-intelligence-backend.vercel.app/api/officer/:path*"
    },
    {
      "source": "/api/tiles/:path*",
      "destination": "https://orca-marine-intelligence-backend.vercel.app/api/tiles/:path*"
    },
    {
      "source": "/api/pfz/today",
      "destination": "https://orca-marine-intelligence-backend.vercel.app/api/pfz/today"
    },
    {
      "source": "/api/pfz/history",
      "destination": "https://orca-marine-intelligence-backend.vercel.app/api/pfz/history"
    },
    {
      "source": "/api/pfz/refresh",
      "destination": "https://orca-marine-intelligence-backend.vercel.app/api/pfz/refresh"
    },
    {
      "source": "/api/route/safe",
      "destination": "https://orca-marine-intelligence-backend.vercel.app/api/route/safe"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ]
}
