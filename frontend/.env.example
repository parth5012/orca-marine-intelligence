# ORCA Marine Intelligence - Frontend Environment Variables

# Backend API endpoint URL (for Next.js client-side proxy & direct requests)
NEXT_PUBLIC_API_URL=http://localhost:8000

# CARTO Base Maps API Key (Optional; for authenticated vector/raster tile access)
# If omitted, left blank, or using placeholder (your_*), keyless anonymous tile endpoints are used.
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# Default Basemap Style:
# Options: dark_all (Dark Matter, default), voyager (Voyager Nautical), light_all (Positron), esri_ocean (Esri Ocean Basemap), esri_dark (Esri Dark Gray), osm (OpenStreetMap)
NEXT_PUBLIC_CARTO_BASEMAP_STYLE=dark_all
