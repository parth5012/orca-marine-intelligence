# ORCA Marine Intelligence Frontend Environment Variables

# Backend API endpoint URL (Next.js client-side proxy & direct requests)
NEXT_PUBLIC_API_URL=http://localhost:8000

# CARTO Base Maps API Key (Optional; authenticated vector/raster tile access)
# If omitted or left blank, public anonymous tile endpoints are used.
NEXT_PUBLIC_CARTO_API_KEY=your_carto_api_key_here

# Default Basemap Style:
# Options: dark_all (Dark Matter, default), voyager (Voyager Nautical), light_all (Positron), osm (OpenStreetMap)
NEXT_PUBLIC_CARTO_BASEMAP_STYLE=dark_all
